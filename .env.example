# Discord
DISCORD_TOKEN=ton_token_ici
DISCORD_CLIENT_ID=id_application
DISCORD_GUILD_ID=id_serveur

# Rôles & salons
ADMIN_ROLE_IDS=123,456
SHOP_CATEGORY_ID=
ORDERS_CATEGORY_ID=
LOGS_CHANNEL_ID=
REVIEWS_CHANNEL_ID=

# Shop
SHOP_NAME=My Shop
CURRENCY=EUR
CURRENCY_SYMBOL=€

# PayPal (manual only)
PAYPAL_EMAIL=you@email.com
PAYPAL_ME_USERNAME=

# ═══════════════════════════════════════════
# CRYPTO — Litecoin only (Exodus BIP44 seed)
# ═══════════════════════════════════════════
# Put your Exodus seed (12 words) here.
# Each payment = new LTC address (L…) → visible in Exodus.
# NEVER share this seed.
CRYPTO_MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12

CRYPTO_CONF_LTC=1
CRYPTO_AMOUNT_TOLERANCE=0.02
CRYPTO_WATCH_INTERVAL_MS=15000
CRYPTO_NETWORK_NOTE=Send Litecoin (LTC) only. Single-use address.

# Serveur HTTP (healthcheck Pterodactyl)
HTTP_PORT=3000
PUBLIC_BASE_URL=https://ton-domaine.com

DATABASE_PATH=./data/shop.db
