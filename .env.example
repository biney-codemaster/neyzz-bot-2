# ═══════════════════════════════════════════
# CRYPTO — HD WALLET (recommandé)
# ═══════════════════════════════════════════
# Seed BIP39 (12/24 mots). C'EST TOI qui possèdes toutes les adresses dérivées.
# Importe la MÊME seed dans Electrum (BTC/LTC) ou MetaMask (ETH/USDT) pour voir l'argent.
# Ne partage JAMAIS cette seed. Backup offline obligatoire.
CRYPTO_MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12

# Coins activés (séparés par des virgules)
CRYPTO_ENABLED_COINS=btc,eth,ltc,usdt

# Confirmations avant livraison auto
CRYPTO_CONF_BTC=1
CRYPTO_CONF_LTC=1
CRYPTO_CONF_ETH=1
CRYPTO_CONF_USDT=1

# Tolérance sous-paiement (0.02 = 2%)
CRYPTO_AMOUNT_TOLERANCE=0.02

# Scan blockchain (ms)
CRYPTO_WATCH_INTERVAL_MS=30000

# RPC Ethereum (publicnode par défaut)
ETH_RPC_URL=https://ethereum.publicnode.com
USDT_CONTRACT=0xdAC17F958D2ee523a2206206994597C13D831ec7

# Adresse perso optionnelle (info / regroupement manuel plus tard)
# L'argent n'arrive PAS directement ici : il arrive sur chaque adresse HD unique.
# Tu regroupes ensuite depuis ta seed vers cette adresse.
CRYPTO_SWEEP_ADDRESS=

CRYPTO_NETWORK_NOTE=Envoie uniquement sur le bon réseau. Adresse à usage unique.

# Serveur HTTP (healthcheck Pterodactyl)
HTTP_PORT=3000
PUBLIC_BASE_URL=https://ton-domaine.com

DATABASE_PATH=./data/shop.db
